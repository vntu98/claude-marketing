# GA4 Data/Admin API
GA4_ACCESS_TOKEN=your_google_oauth_access_token
GA4_PROPERTY_ID=123456789

# GA4 Measurement Protocol
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=replace_with_measurement_protocol_secret

# Defaults used by report presets
GA4_DEFAULT_LOOKBACK_DAYS=30
GA4_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
GA4_DEFAULT_PRIMARY_CONVERSION=app_store_subscription_convert
GA4_DEFAULT_SECONDARY_CONVERSION=in_app_purchase

# Project-specific analytics context
GA4_SITE_DOMAIN=example.com
GA4_SITE_NAME=eUp Language Learning

# Search Console
GSC_ACCESS_TOKEN=your_google_search_console_access_token

# SEO / competitor intelligence
SEMRUSH_API_KEY=your_semrush_api_key

# Social publishing
BUFFER_API_KEY=your_buffer_api_key
ZAPIER_API_KEY=your_zapier_api_key

# Paid media
META_ACCESS_TOKEN=your_meta_access_token
META_AD_ACCOUNT_ID=1234567890
GOOGLE_ADS_TOKEN=your_google_ads_oauth_access_token
GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_developer_token
GOOGLE_ADS_CUSTOMER_ID=1234567890
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
TIKTOK_ADVERTISER_ID=1234567890

# Email / lifecycle
MAILCHIMP_API_KEY=your_mailchimp_api_key-us21
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# CRO / research
HOTJAR_CLIENT_ID=your_hotjar_client_id
HOTJAR_CLIENT_SECRET=your_hotjar_client_secret
TYPEFORM_API_KEY=your_typeform_api_key
OPTIMIZELY_API_KEY=your_optimizely_api_key

# Growth / links / content ops
DUB_API_KEY=your_dub_api_key
AIROPS_API_KEY=your_airops_api_key
AIROPS_WORKSPACE_ID=your_airops_workspace_id
