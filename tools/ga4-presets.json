            "activity_video_tab_quiz_start",
            "activity_video_tab_quiz_complete",
            "activity_video_tab_saved_review_complete",
            "activity_video_tab_matching_complete",
            "activity_video_tab_ai_talk_start",
            "activity_video_tab_ai_talk_complete"
          ]
        }
      }
    }
  },
