{
  "acquisition-overview": {
    "type": "report",
    "description": "Channel and campaign quality snapshot.",
    "dateRanges": [
      {
        "startDate": "30daysAgo",
        "endDate": "today"
      }
    ],
    "dimensions": [
      "sessionSource",
      "sessionMedium",
      "sessionCampaignName"
    ],
    "metrics": [
      "sessions",
      "activeUsers",
      "newUsers",
      "conversions",
      "engagementRate"
    ]
  },
  "landing-page-performance": {
    "type": "report",
    "description": "Landing page performance by source and medium.",
    "dateRanges": [
      {
        "startDate": "30daysAgo",
        "endDate": "today"
      }
    ],
    "dimensions": [
      "landingPage",
      "sessionSource",
      "sessionMedium"
    ],
    "metrics": [
      "sessions",
      "activeUsers",
      "conversions",
      "engagementRate"
    ]
  },
  "learner-journey-funnel": {
    "type": "report",
    "description": "Minimal watch and per-tab practice funnel for the mobile learning experience.",
    "dateRanges": [
      {
        "startDate": "30daysAgo",
        "endDate": "today"
      }
    ],
    "dimensions": [
      "eventName"
    ],
    "metrics": [
      "eventCount",
      "totalUsers"
    ],
    "dimensionFilter": {
      "filter": {
        "fieldName": "eventName",
        "inListFilter": {
          "values": [
            "activity_video_watch",
            "activity_word_define",
            "activity_word_save",
            "activity_video_tab_notes_view",
            "activity_video_tab_vocab_view",
            "activity_video_tab_speaking_start",
